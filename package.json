{
  "name": "riftrunner",
  "version": "1.0.0",
  "description": "RIFTRUNNER - offline platformer with 110 levels",
  "main": "main.js",
  "author": "RIFTRUNNER",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.riftrunner.game",
    "productName": "RIFTRUNNER",
    "files": [
      "main.js",
      "index.html",
      "splash.html",
      "icon.png",
      "icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "Game.exe"
    },
    "asar": true
  }
}